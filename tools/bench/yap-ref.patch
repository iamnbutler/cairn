diff --git a/App/Bench.swift b/App/Bench.swift
new file mode 100644
index 0000000..8dff1af
--- /dev/null
+++ b/App/Bench.swift
@@ -0,0 +1,225 @@
+@preconcurrency import AVFoundation
+import AppKit
+import os
+
+// bench: the bench mode added to this copy of Yap for Cairn's Instruments comparison
+// (cairn: tools/bench/yap-ref.patch, bench/yap-instruments.md). It mirrors CairnYap's
+// Bench.swift: the same synthetic voice fed in real time through the real capture callback
+// (PCMRecorder.append, which the overlay's level reads), the key pressed at PushToTalk's
+// callbacks, OpenAI a URLProtocol stub answering at once, and typing a stub that marks where the
+// first key event would be posted. Nothing here times anything: it emits os_signposts
+// (subsystem dev.yap.bench) and Instruments timestamps them.
+//
+//   --bench-overlay [--seconds 20] [--buffer-ms 20] [--screen I]
+//   --bench-latency [--trials 21]
+//   --bench-idle | --bench-menu
+// Run with YAP_BENCH_HOME=<scratch dir> so no real file is read or written.
+
+let benchLog = OSLog(subsystem: "dev.yap.bench", category: "bench")
+
+enum BenchVoice {
+    static func level(_ t: Double) -> Double {
+        let phrase = t.truncatingRemainder(dividingBy: 3.2)
+        guard phrase < 2.5 else { return 0.02 }
+        let syllables = abs(sin(t * 9)) * (0.55 + 0.45 * sin(t * 1.7))
+        return min(1, 0.15 + syllables * 0.8)
+    }
+
+    static func samples(from start: Int, count: Int) -> [Int16] {
+        (0..<count).map { j in
+            let n = start + j
+            let a = Int16(level(Double(n) / 16000) * 12000)
+            return n % 2 == 0 ? a : -a
+        }
+    }
+}
+
+final class BenchLocked<T>: @unchecked Sendable {
+    private let lock = NSLock()
+    private var v: T
+    init(_ v: T) { self.v = v }
+    var value: T {
+        get { lock.lock(); defer { lock.unlock() }; return v }
+        set { lock.lock(); v = newValue; lock.unlock() }
+    }
+    func update(_ f: (inout T) -> Void) { lock.lock(); f(&v); lock.unlock() }
+}
+
+final class BenchOpenAI: URLProtocol, @unchecked Sendable {
+    static let phrases = [
+        "So the overlay should feel like a little tape machine,",
+        "with the reel turning while I talk",
+        "and an orange mark on the tape wherever a phrase was cut.",
+    ]
+    static let count = BenchLocked(0)
+
+    override class func canInit(with request: URLRequest) -> Bool { true }
+    override class func canonicalRequest(for request: URLRequest) -> URLRequest { request }
+    override func startLoading() {
+        var n = 0
+        Self.count.update { n = $0; $0 += 1 }
+        let text = Self.phrases[n % Self.phrases.count]
+        let json = try! JSONSerialization.data(withJSONObject: ["text": text])
+        let resp = HTTPURLResponse(url: request.url!, statusCode: 200, httpVersion: "HTTP/1.1",
+                                   headerFields: ["Content-Type": "application/json"])!
+        client?.urlProtocol(self, didReceive: resp, cacheStoragePolicy: .notAllowed)
+        client?.urlProtocol(self, didLoad: json)
+        client?.urlProtocolDidFinishLoading(self)
+    }
+    override func stopLoading() {}
+}
+
+/// The microphone the bench feeds: AudioCapture hands it its callback instead of starting
+/// AVAudioEngine; `push` delivers a 16 kHz mono PCM16 buffer from the feeding thread, as the
+/// realtime audio thread would.
+final class BenchMic: @unchecked Sendable {
+    static let shared = BenchMic()
+    private let lock = NSLock()
+    private var sink: (@Sendable (AVAudioPCMBuffer) -> Void)?
+    private var format: AVAudioFormat?
+
+    func start(format: AVAudioFormat, _ onInput: @escaping @Sendable (AVAudioPCMBuffer) -> Void) {
+        lock.lock(); self.format = format; sink = onInput; lock.unlock()
+    }
+    func stop() { lock.lock(); sink = nil; lock.unlock() }
+    var live: Bool { lock.lock(); defer { lock.unlock() }; return sink != nil }
+
+    func push(_ samples: [Int16]) {
+        lock.lock()
+        defer { lock.unlock() }
+        guard let sink, let format,
+              let b = AVAudioPCMBuffer(pcmFormat: format, frameCapacity: AVAudioFrameCount(samples.count))
+        else { return }
+        b.frameLength = AVAudioFrameCount(samples.count)
+        samples.withUnsafeBufferPointer { b.int16ChannelData![0].update(from: $0.baseAddress!, count: samples.count) }
+        sink(b)
+    }
+}
+
+enum Bench {
+    enum Kind { case overlay, latency, idle, menu }
+
+    static let args = CommandLine.arguments
+    static let mode: Kind? = {
+        if args.contains("--bench-overlay") { return .overlay }
+        if args.contains("--bench-latency") { return .latency }
+        if args.contains("--bench-idle") { return .idle }
+        if args.contains("--bench-menu") { return .menu }
+        return nil
+    }()
+    static func value(_ flag: String) -> String? {
+        args.firstIndex(of: flag).flatMap { $0 + 1 < args.count ? args[$0 + 1] : nil }
+    }
+    static let seconds = value("--seconds").flatMap(Double.init) ?? 20
+    static let bufferMs = value("--buffer-ms").flatMap(Int.init).flatMap { $0 >= 20 && $0 % 20 == 0 ? $0 : nil } ?? 20
+    static let trials = value("--trials").flatMap(Int.init) ?? 21
+    static let screen = value("--screen").flatMap(Int.init)
+
+    static let trial = BenchLocked(0)
+    static let typedCount = BenchLocked(0)
+
+    static func fail(_ msg: String) -> Never {
+        FileHandle.standardError.write("FAIL: bench: \(msg)\n".data(using: .utf8)!)
+        exit(1)
+    }
+
+    /// Typing reached the point where it would post its first key event.
+    static func typed(_ runs: Int) {
+        os_signpost(.end, log: benchLog, name: "keyUpToTyped", signpostID: OSSignpostID(UInt64(trial.value)))
+        typedCount.update { $0 += 1 }
+    }
+
+    static func wait(_ what: String, _ timeout: Double = 20, _ ok: () -> Bool) {
+        let deadline = Date(timeIntervalSinceNow: timeout)
+        while !ok() {
+            if Date() > deadline { fail(what) }
+            usleep(1000)
+        }
+    }
+
+    static func feed(seconds: Double, bufferMs: Int) {
+        let per = 16 * bufferMs, n = Int(seconds * 1000) / bufferMs
+        let start = DispatchTime.now().uptimeNanoseconds
+        for i in 0..<n {
+            let due = start + UInt64(i * bufferMs) * 1_000_000
+            let now = DispatchTime.now().uptimeNanoseconds
+            if due > now { usleep(UInt32((due - now) / 1000)) }
+            os_signpost(.event, log: benchLog, name: "level")
+            BenchMic.shared.push(BenchVoice.samples(from: i * per, count: per))
+        }
+    }
+
+    /// Starts the driver. `down` and `up` are PushToTalk's onDown and onUp, called on the main
+    /// thread as its NSEvent monitors call them.
+    @MainActor
+    static func start(down: @escaping @MainActor () -> Void, up: @escaping @MainActor () -> Void) {
+        // Where the real app starts its key monitor: ready to dictate.
+        os_signpost(.event, log: benchLog, name: "ready")
+        URLProtocol.registerClass(BenchOpenAI.self)
+        setenv("OPENAI_API_KEY", "sk-bench", 1)  // the stub's; secrets.env is never read
+        let keyDown: @Sendable () -> Void = { DispatchQueue.main.async { MainActor.assumeIsolated { down() } } }
+        let driver = Thread {
+            usleep(1_000_000)
+            switch mode {
+            case .overlay:
+                os_signpost(.event, log: benchLog, name: "tap")
+                keyDown()
+                wait("no microphone") { BenchMic.shared.live }
+                let feeder = Thread { feed(seconds: seconds, bufferMs: bufferMs) }
+                os_signpost(.begin, log: benchLog, name: "levels")
+                feeder.start()
+                usleep(100_000)
+                DispatchQueue.main.async { MainActor.assumeIsolated { up() } }
+                usleep(UInt32(seconds * 1_000_000))
+                os_signpost(.end, log: benchLog, name: "levels")
+                os_signpost(.event, log: benchLog, name: "tap")
+                keyDown()
+                DispatchQueue.main.async { MainActor.assumeIsolated { up() } }
+                wait("never typed", 10) { typedCount.value > 0 }
+                usleep(2_500_000)
+            case .latency:
+                for t in 1...max(1, trials) {
+                    trial.value = t
+                    let before = typedCount.value
+                    keyDown()
+                    wait("no microphone") { BenchMic.shared.live }
+                    feed(seconds: 1.0, bufferMs: 20)
+                    DispatchQueue.main.async {
+                        os_signpost(.begin, log: benchLog, name: "keyUpToTyped", signpostID: OSSignpostID(UInt64(t)))
+                        MainActor.assumeIsolated { up() }
+                    }
+                    wait("trial \(t) never typed", 10) { typedCount.value > before }
+                    wait("the microphone stayed on") { !BenchMic.shared.live }
+                    usleep(2_500_000)
+                }
+            case .menu:
+                usleep(2_000_000)
+                DispatchQueue.main.async {
+                    os_signpost(.event, log: benchLog, name: "menuOpen")
+                    if !MainActor.assumeIsolated({ openStatusMenu() }) { fail("no status item button") }
+                }
+                return
+            case .idle, nil:
+                return
+            }
+            print("bench: done; \(BenchOpenAI.count.value) transcription requests, \(typedCount.value) typed")
+            exit(0)
+        }
+        driver.qualityOfService = .userInitiated
+        driver.start()
+    }
+
+    @MainActor
+    static func openStatusMenu() -> Bool {
+        func button(_ v: NSView?) -> NSButton? {
+            guard let v else { return nil }
+            if let b = v as? NSButton { return b }
+            for s in v.subviews { if let b = button(s) { return b } }
+            return nil
+        }
+        for w in NSApp.windows where String(describing: type(of: w)).contains("StatusBar") {
+            if let b = button(w.contentView) { b.performClick(nil); return true }
+        }
+        return false
+    }
+}

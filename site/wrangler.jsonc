{
  "name": "cairn",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // The package pages read a Cairn package registry (a nextpm `cairn` registry) when
  // REGISTRY_URL is set here and REGISTRY_TOKEN is a secret (`wrangler secret put`). Without
  // them they show site/registry/fixture.json, marked as sample data.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "cairn-media" }]
}

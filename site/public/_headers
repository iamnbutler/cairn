# The docs for language models (tools/site/llms.ts, tools/doc/markdown.ts) are UTF-8; without a
# charset a browser reads ^, → and – as Latin-1.
/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8
/docs/api/llms.txt
  Content-Type: text/plain; charset=utf-8
/docs/*.md
  Content-Type: text/markdown; charset=utf-8
# The try pages' list of where their graphs and frames are (tools/try/put.ts): always fresh, so a
# new capture shows on the next load. The graphs and frames themselves are /m/ keys, cached forever.
/try/apps.json
  Cache-Control: no-cache
# The fonts never change under the same name, so a visit after the first has them before the
# page paints and the pixel text doesn't swap in late.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

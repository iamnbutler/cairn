# The milestones became the blog on 2026-11-02. The fragment carries over, and the blog's index
# sends an old section's id (#fourth-milestone-sky-reads-bluesky, a video's) on to its post.
/milestones /blog/ 301
/milestones/ /blog/ 301
# The docs' sections were renamed on 2026-10-24: book → guide, use → reference, master → internals.
/docs/book/* /docs/guide/:splat 301
/docs/use/* /docs/reference/:splat 301
/docs/master/* /docs/internals/:splat 301
# The example apps' pages went with the apps to cairn_examples (#137, 0.3.0).
/docs/examples/counter/* /docs/examples/ 301
/docs/examples/basics/* /docs/examples/ 301
/docs/examples/todo/* /docs/examples/ 301
# The maps were replaced by the packages' claim pages on 2026-10-24. A fragment (#202) carries
# over: each claim is a row with its id on its place's page. The examples' claims are
# cairn_examples's since 0.3.0, with the same numbers.
/map/counter/* /packages/cairn_examples/claims/3/ 301
/map/basics/* /packages/cairn_examples/claims/106/ 301
/map/todo/* /packages/cairn_examples/claims/201/ 301
/map/trusted/* /packages/cairn/claims/ 301
/map/* /packages/cairn/claims/ 301

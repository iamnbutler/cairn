<script type="module">
  import { mountScene, mountFrames, mountSprigs, mountAnchors } from "/scene.js";
  import { list, fillLogs } from "/media.js";
  const main = document.querySelector("main");
  mountFrames(main);
  mountSprigs(main);
  mountAnchors(main);
  mountScene(document.getElementById("scene"));
  // The logs arrive after the page has drawn, so a link to a video's heading scrolls once they do.
  list().then(all => {
    fillLogs(main, all);
    const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
    if (target) target.scrollIntoView();
  }).catch(() => { for (const log of main.querySelectorAll("[id^=log-]")) log.innerHTML = '<li class="meta">Could not load the video list.</li>'; });
</script>

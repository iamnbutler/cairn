{{! The "Try it" pages (docs/try.md): /try/ picks an app, /try/<app>/ runs its explored states
    with site/public/try/try.js. The data (graph.json, img/) is written at deploy by `make site-try`. }}
{{#var p = $page.params}}
{{#var title = $page.title + ' · Cairn'}}
{{#var card = await $assets.render('og/card', undefined, { args: { label: 'Try it', title: $page.title, line: '' } })}}
<!doctype html>
<html lang="{{ $site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ p.description }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Cairn">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ p.description }}">
<meta property="og:url" content="{{ $page.url }}">
<meta property="og:image" content="{{ $utils.url.abs(card) }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ $page.title }}, over a pixel cairn on a meadow by a lake at night">
<meta name="twitter:card" content="summary_large_image">
{{{ $utils.head('/docs/docs.css') }}}
<link rel="stylesheet" href="/packages.css">
<link rel="stylesheet" href="/try/try.css">
</head>
<body>
{{{ $utils.bar('') }}}
<main class="try">
<header class="page">
<p class="eyebrow">Try it</p>
<h1>{{ $page.title }}</h1>
<p class="lede">{{ p.lede }}</p>
</header>
{{{ $page.content }}}
</main>
<footer>Every frame here was drawn by the app's own Lean code, explored ahead of time by <code>make site-try</code>. Nothing on this page decides what an action does.</footer>
<script type="module">
  import { mountAnchors } from "/scene.js";
  mountAnchors(document.querySelector("main"));
</script>
</body>
</html>

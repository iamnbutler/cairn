{{#var p = $page.params}}
{{#var index = $page.path === '/docs/'}}
{{#var title = index ? 'Cairn docs' : $page.title + ' · Cairn docs'}}
{{#var lede = String(p.lede ?? '')}}
{{#var desc = lede.split('`').join('')}}
{{#var isTodo = p.status === 'todo'}}
{{#var _ = $utils.checkLinks($page.path, $page.content + $utils.inline(lede), $pages)}}
<!doctype html>
<html lang="{{ $site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
{{#if lede}}<meta name="description" content="{{ desc }}">{{/if}}
{{#var card = await $assets.render('og/card')}}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Cairn">
<meta property="og:title" content="{{ title }}">
{{#if lede}}<meta property="og:description" content="{{ desc }}">{{/if}}
<meta property="og:url" content="{{ $page.url }}">
<meta property="og:image" content="{{ $utils.url.abs(card) }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ title }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400..700&display=swap" rel="stylesheet">
<bongo:style src="docs.css"></bongo:style>
</head>
<body>
<header class="bar">
  <a class="home" href="/"><img src="/icon.svg" alt="">Cairn</a>
  <a href="/milestones/">Milestones</a>
  <a href="/docs/"{{#if index}} class="on"{{/if}}>Docs</a>
  <a href="/packages/">Packages</a>
  <a href="/docs/evidence/">Maps</a>
</header>
<div class="layout">
<details class="side" open>
<summary>Contents</summary>
<nav aria-label="Docs">{{{ $utils.sidebar($page.path, $pages, $data.nav) }}}</nav>
</details>
<script>if (matchMedia("(max-width: 900px)").matches) document.querySelector("details.side").open = false;</script>
<main>
<header class="page">
{{#if p.eyebrow || isTodo}}<p class="eyebrow">{{ p.eyebrow ?? '' }}{{#if isTodo}}<span class="todo">not written yet</span>{{/if}}</p>{{/if}}
<h1>{{ $page.title }}</h1>
{{#if lede}}<p class="lede">{{{ $utils.inline(lede) }}}</p>{{/if}}
</header>
<article class="prose">
{{{ $page.content }}}
</article>
{{{ $utils.pager($page.path, $pages, $data.nav) }}}
</main>
</div>
<footer>Cairn is research, and these docs grow with it. The code samples are included from the source that <code>make check</code> builds.</footer>
<script type="module">
  import { mountAnchors } from "/scene.js";
  mountAnchors(document.querySelector("main"));
</script>
</body>
</html>

{{#var p = $page.params}}
{{#var home = $page.path === '/'}}
{{#var title = home ? $page.title : $page.title + ' · Cairn'}}
{{#var card = await $assets.render('og/card', undefined, { args: p.card })}}
<!doctype html>
<html lang="{{ $site.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ p.description }}">
{{! The claim figures' base rules first, so site.css's wide layout of the anatomy wins. }}
{{#if home}}<link rel="stylesheet" href="/claims/claims.css">{{/if}}
{{{ $utils.head('/site.css') }}}
<link rel="modulepreload" href="/scene.js">
<link rel="modulepreload" href="/anchors.js">
<link rel="alternate" type="application/rss+xml" title="Cairn" href="/feed.xml">
{{#if home}}
<script>
  // The milestones were here once, then on /milestones/, and are blog posts now. A link from
  // before to one of their sections goes on to the same post; the server never sees the hash, so
  // this runs before the page draws. lib/site.ts lists the ids.
  { const to = {{{ JSON.stringify($utils.oldLinks($page.content)) }}}[decodeURIComponent(location.hash.slice(1))]; if (to) location.replace(to); }
</script>
{{/if}}
<meta property="og:type" content="website">
<meta property="og:site_name" content="Cairn">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ p.description }}">
<meta property="og:url" content="{{ $page.url }}">
<meta property="og:image" content="{{ $utils.url.abs(card) }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ p.card.title }}, over a pixel cairn on a meadow by a lake at night">
<meta name="twitter:card" content="summary_large_image">
</head>
<body>
{{{ $page.content }}}
</body>
</html>

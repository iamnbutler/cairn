def wordTable : Array (Nat × Bool) :=
  ((wordText.splitOn " ").filterMap fun e => match e.splitOn ":" with
    | [a, b] => some (Graphemes.hexVal a.toList, b == "1")
    | _ => none).toArray

def foldTable : Array (Nat × List Char) :=
  ((foldText.splitOn " ").filterMap fun e => match e.splitOn ":" with
    | [a, b] => some (Graphemes.hexVal a.toList,
        (b.splitOn ".").map fun h => Char.ofNat (Graphemes.hexVal h.toList))
    | _ => none).toArray

/-- The last entry at or below `v` in a table sorted by code point. -/
def lookup {α : Type} [Inhabited α] (t : Array (Nat × α)) (v : Nat) : Option (Nat × α) := Id.run do
  if t.size = 0 then return none
  if v < t[0]!.1 then return none
  let mut lo := 0
  let mut hi := t.size
  while lo + 1 < hi do
    let mid := (lo + hi) / 2
    if t[mid]!.1 ≤ v then lo := mid else hi := mid
  return some t[lo]!

/-- A character `[\w-]` matches: a word character, for the fix's lookarounds. -/
def isWord (c : Char) : Bool := ((lookup wordTable c.toNat).map (·.2)).getD false

/-- Full case folding. -/
def fold (c : Char) : List Char :=
  match lookup foldTable c.toNat with
  | some (k, f) => if k = c.toNat then f else [c]
  | none => [c]

end Examples.Yap.Fold
